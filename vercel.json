{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__path=:path*"
    }
  ],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/lembretes",
      "schedule": "0 11 * * *"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/palpite/:token",
      "destination": "/index.html"
    },
    {
      "source": "/envelope/:token",
      "destination": "/index.html"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__path=:path*"
    }
  ],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/lembretes",
      "schedule": "0 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gestacao-app.vercel.app"
        }
      ],
      "destination": "https://meutumtum.com.br/:path*",
      "permanent": false
    }
  ]
}
